# ==========================================
# OpenInfraIQ Backend - Environment Variables
# ==========================================

# Server Port (automatically set by Railway, default 8080)
PORT=8080

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/openinfra_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# GitHub Personal Access Token (Never expose to frontend!)
# Increases rate limits from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=ghp_your_github_token_here

# Frontend URL (For production CORS whitelist, e.g. Vercel deployment)
FRONTEND_URL=https://openinfraiq.vercel.app

# Firebase Admin SDK Credentials (For Railway / Production)
FIREBASE_PROJECT_ID=openinfra2-19e9d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@openinfra2-19e9d.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: Path to serviceAccountKey.json if using file-based credential loading
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
